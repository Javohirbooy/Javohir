# --- Qanday ishlatiladi ---
# Birinchi marta: `npm run env:bootstrap` (.env yaratadi + tasodifiy AUTH_SECRET). Keyin Neon `DATABASE_URL` / `DIRECT_URL`.
# Tekshiruv: `npm run env:check`
# Build/dev: `cd edu-platform` → `npm run dev` / `npm run verify`
# Xato matnini PowerShell ga qator-qator qo‘ymang (`.env`, `at <unknown>` buyruq deb olinadi).

# ========== Neon PostgreSQL (majburiy production) ==========
# Pooled — Vercel / serverless (Neon "Pooled connection" + pgbouncer=true)
# Ixtiyoriy: serverlessda kichik pool — `connection_limit=1` (Neon + Prisma tavsiyasi)
DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Prisma client URL tuning (build: NEXT_PHASE orqali avtomatik ham bor)
# PRISMA_CONNECTION_LIMIT="5"
# PRISMA_POOL_TIMEOUT="40"
# next build SSG parallel (defaultlar next.config da 4 va 32)
# NEXT_STATIC_GEN_MAX_CONCURRENCY="4"
# NEXT_STATIC_GEN_MIN_PAGES_PER_WORKER="32"

# Direct — prisma migrate / db push (poolersiz hostname)
DIRECT_URL="postgresql://USER:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ========== NextAuth / Auth.js v5 ==========
# Kamida 32 belgi, tasodifiy (productionda majburiy)
AUTH_SECRET="o‘zgartiring-uzun-maxfiy-kalit-kamida-32-belgi"

# Canonical HTTPS origin (OG, metadataBase, email linklari). Vercelda bo‘lmasa VERCEL_URL ishlatiladi.
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Production: to‘liq HTTPS URL (callback va cookie konteksti)
# NEXTAUTH_URL="https://your-domain.example"
# AUTH_URL="https://your-domain.example"

# Vercel Cron / ichki scheduler: GET/POST /api/cron/olympiad-finalize
# Productionda majburiy — Authorization: Bearer <CRON_SECRET> yoki x-cron-secret
# CRON_SECRET=""

# ========== Ixtiyoriy (umumiy) ==========
# Vercelda odatda avtomatik; preview uchun
# VERCEL_URL="your-app.vercel.app"

# Ro‘yxatdan o‘tish: 1 yoqilgan, 0 o‘chirilgan
# NEXT_PUBLIC_ENABLE_REGISTRATION="0"

# Auth debug (faqat dev; productionda o‘chiq tavsiya)
# IQM_AUTH_DEBUG="1"
# NEXT_PUBLIC_AUTH_DEBUG="0"

# ========== Upstash Redis (tavsiya: Vercel ko‘p instansiya) ==========
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXXX..."

# GET /api/health da Redis PING (ixtiyoriy; biroz kechikish qo‘shadi)
# HEALTH_CHECK_REDIS="1"

# ========== HTTPS / HSTS ==========
# Faqat butun sayt doimiy HTTPS bo‘lgach (subdomenlar bilan tekshiring)
# ENABLE_HSTS="1"

# Dev / CI / mahalliy next start: http URL ruxsat (production Vercelda qo‘ymang)
# ALLOW_INSECURE_SITE_URL="1"
# SKIP_PRODUCTION_HTTPS_ENFORCEMENT="1"

# ========== Email (Resend) ==========
# RESEND_API_KEY="re_..."
# RESEND_FROM="IQ Platform <noreply@your-domain.example>"

# ========== Vercel Blob (avatar yuklash) ==========
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ========== Sentry ==========
# Brauzer: faqat NEXT_PUBLIC_SENTRY_DSN (DSN public hisoblanadi)
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# Server/Edge: ixtiyoriy alohida DSN (bundle ga kiritilmasin)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_ENVIRONMENT="production"
# SENTRY_TRACES_SAMPLE_RATE="0.12"
# NEXT_PUBLIC_SENTRY_RELEASE="1.0.0"
# Sentry build (source map upload) — faqat CI / build muhiti
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_DEBUG="1"
